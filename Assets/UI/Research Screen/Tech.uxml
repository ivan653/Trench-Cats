<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement template="Slot">
        <ui:Button name="Button" style="width: 150px; height: 170px; margin: 6px; padding: 6px; background-color: rgb(43, 43, 43); border-radius: 6px; align-items: center; justify-content: space-between;">
            <ui:VisualElement name="ActvePanel" style="flex-grow: 1; justify-content: flex-start; align-self: center; flex-direction: column; align-items: center; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); background-image: none; display: flex; visibility: visible; overflow: visible; opacity: 1;">
                <ui:VisualElement name="TechIcon" style="width: 90px; height: 90px; background-color: rgb(68, 68, 68); border-radius: 4px;"/>
                <ui:Label name="TechName" text="Tech Name" style="color: white; font-size: 20px; -unity-text-align: middle-center;"/>
                <ui:Label name="TechCost" text="100s" style="color: rgb(0, 195, 255); font-size: 20px; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
