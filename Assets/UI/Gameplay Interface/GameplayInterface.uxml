<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="SlotsContainer" style="flex-grow: 1; width: 50%; flex-direction: column; flex-wrap: nowrap; max-width: 50%;">
            <ui:VisualElement name="UnitSlotsContainer" style="flex-grow: 1; max-width: 100%; max-height: 50%;"/>
            <ui:VisualElement name="BuildingSlotsContainer" style="flex-grow: 1; align-self: flex-end; width: 100%; height: 50%; max-height: 50%; max-width: 100%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="AbilitySlotsContainer" style="flex-grow: 1; align-items: auto; max-width: 25%; width: 25%;"/>
        <ui:VisualElement name="StatsContainer" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="FundsContainer" template="StatBar" style="max-width: 50%; width: 50%; max-height: 100px;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgb(43, 43, 43); -unity-background-image-tint-color: rgb(255, 255, 255); border-top-color: rgb(149, 149, 149); border-left-width: 1px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); background-size: 100% 50%; white-space: normal; flex-direction: row; flex-wrap: nowrap;">
                    <ui:VisualElement name="StatIcon" style="width: 50%; height: 100%; background-color: rgb(68, 68, 68); border-radius: 4px; background-image: url(&quot;project://database/Packages/com.unity.collab-proxy/Editor/Assets/Images/d_iconoutofsync@2x.png?fileID=2800000&amp;guid=f82dfc5fc3c5a8f4080a3550427019c8&amp;type=3#d_iconoutofsync@2x&quot;);"/>
                    <ui:Label name="Value" text="0" style="color: rgb(255, 215, 0); font-size: 20px; -unity-text-align: middle-center; height: 100%; width: 50%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CommandPointsContainer" template="StatBar" style="width: 50%; max-height: 100px;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgb(43, 43, 43); -unity-background-image-tint-color: rgb(255, 255, 255); border-top-color: rgb(149, 149, 149); border-left-width: 1px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); background-size: 100% 50%; white-space: normal; flex-direction: row; flex-wrap: nowrap;">
                    <ui:VisualElement name="StatIcon" style="width: 50%; height: 100%; background-color: rgb(68, 68, 68); border-radius: 4px; background-image: url(&quot;project://database/Packages/com.unity.2d.animation/Editor/Assets/ComponentIcons/Animation.IKFabrik%20On@64.png?fileID=2800000&amp;guid=009774248359949e3b9317677c6678da&amp;type=3#Animation.IKFabrik On@64&quot;);"/>
                    <ui:Label name="Value" text="0" style="color: rgb(255, 215, 0); font-size: 20px; -unity-text-align: middle-center; height: 100%; width: 50%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
