<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button name="SlotButton" style="width: 150px; height: 170px; margin: 6px; padding: 6px; background-color: #2b2b2b; border-radius: 6px; align-items: center; justify-content: space-between;">
        <!-- Прев'ю іконки -->
        <ui:VisualElement name="UnitIcon" style="width: 90px; height: 90px; background-color: #444; border-radius: 4px;" />
        <!-- Назва та ціна -->
        <ui:Label name="UnitName" text="Unit Name" style="color: white; font-size: 20px; -unity-text-align: middle-center;" />
        <ui:Label name="UnitCost" text="100g" style="color: #ffd700; font-size: 20px; -unity-text-align: middle-center;" />
    </ui:Button>
</ui:UXML>